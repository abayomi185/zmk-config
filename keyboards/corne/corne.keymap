#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

// Moving the trackball turns on the Mouse layer until it has been still for 800 ms.
// It stays off while typing (200 ms idle), and any key other than the clicks and
// modifiers turns it off, so typing resumes straight away.
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    //                     RCTRL LCTRL S  D  F  LSHFT RSHFT GUI/ALT
    excluded-positions = <11    12    14 15 16 24    35    36>;
};

&trackball_listener {
    input-processors = <&zip_temp_layer 4 800>;

    // Hold Raise and roll to scroll
    scroll {
        layers = <3>;
        input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 4>;
    };

    // Hold Lower and roll for slow, precise movement
    precise {
        layers = <2>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
};

&soft_off {
    hold-time-ms = <3000>; // Only turn off if the key is held for 3 seconds or longer.
    /delete-property/ split-peripheral-off-on-press; // Apply the hold time to the right half too.
};

&mt {
    tapping-term-ms = <200>;
};

/ {
        behaviors {
            lguilalt: tap_dance_0 {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <300>;
                bindings = <&kp LGUI>, <&kp LALT>;
            };

            layrswtch: tap_dance_1 {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <300>;
                bindings = <&mo 2>, <&mo 3>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                    display-name = "Base";
// -----------------------------------------------------------------------------------------
// | TAB/ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |   I   |  O  |  P  | RCTRL |
// | CTRL    |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |   K   |  L  |  ;  |  '   |
// | SHFT    |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |   ,   |  .  |  /  | SHFT |
//                       |TPD0 |LOWER| SPC |   | ENT |RAISE | BSPC  |
                    bindings = <
   &mt ESC TAB  &kp Q  &kp W  &kp E     &kp R       &kp T           &kp Y   &kp U  &kp I     &kp O   &kp P    &kp RCTRL
   &kp LCTRL    &kp A  &kp S  &kp D     &kp F       &kp G           &kp H   &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT    &kp Z  &kp X  &kp C     &kp V       &kp B           &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                              &lguilalt &layrswtch  &kp SPACE       &kp RET &mo 3  &kp BSPC
                    >;
                };

                work_layer {
                    display-name = "Work";
// Toggled from Lower. Starts all transparent; customise with ZMK Studio.
                    bindings = <
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                 &trans &trans &trans   &trans &trans &trans
                    >;
                };

                lower_layer {
                    display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | F24 |
// |  `  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  ~  |
// | TOG |WORK |STUDI|     |BT_PV|BT_NT|   |  _  |PSCRN|     |  {  |  }  | "|" |
//                   |STOFF|     |BTCLR|   |     |     | BSPC|
                    bindings = <
   &trans       &kp N1     &kp N2     &kp N3       &kp N4       &kp N5              &kp N6      &kp N7    &kp N8    &kp N9    &kp N0   &kp F24
   &kp GRAVE    &kp EXCL   &kp AT     &kp HASH     &kp DLLR     &kp PRCNT           &kp CARET   &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR &kp TILDE
   &out OUT_TOG &tog 1     &studio_unlock &trans       &bt BT_PRV   &bt BT_NXT          &kp UNDER   &kp PSCRN &trans    &kp LBRC  &kp RBRC &kp PIPE
                                      &soft_off    &trans       &bt BT_CLR           &trans      &trans    &kp BSPC
                    >;
                };

                raise_layer {
                    display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | PG_UP |
// | F1  | F2  | F3  | F4  | F5  | F6  |   | <-  |  v  |  ^  | ->  | CAPS| PG_DN |
// | F7  | F8  | F9  | F10 | F11 | F12 |   |  -  |  +  |  =  |  [  |  ]  |   \   |
//                   |     |     |     |   |     |     | DEL |
                    bindings = <
   &trans    &kp N1   &kp N2 &kp N3   &kp N4   &kp N5        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0   &kp PG_UP
   &kp F1    &kp F2   &kp F3 &kp F4   &kp F5   &kp F6        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp CAPS &kp PG_DN
   &kp F7    &kp F8   &kp F9 &kp F10  &kp F11  &kp F12       &kp MINUS &kp PLUS  &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH
                             &trans   &trans   &trans        &trans    &trans    &kp DEL
                    >;
                };

                mouse_layer {
                    display-name = "Mouse";
// Turned on by trackball movement. The ball's own button is also a left click.
// -----------------------------------------------------------------------------------------
// |     |     |     |     |     |     |   |     |     |     |     |     |     |
// |     |     | MMB | RMB | LMB |     |   |     |     |     |     |     |     |
// |     |     |     |     |     |     |   |     |     |     |     |     |     |
//                   |     |     |     |   |     |     |     |
                    bindings = <
   &trans &trans &trans    &trans    &trans    &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &mkp MCLK &mkp RCLK &mkp LCLK &trans   &trans &trans &trans &trans &trans &trans
   &trans &trans &trans    &trans    &trans    &trans   &trans &trans &trans &trans &trans &trans
                           &trans    &trans    &trans   &trans &trans &trans
                    >;
                };
        };
};
