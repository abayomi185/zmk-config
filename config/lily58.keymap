#include <dt-bindings/led/led.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <35>; };

/ {
    combos {
        compatible = "zmk,combos";

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <31 32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4     |  5    |                   |  6   |  7     |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R     |  T    |                   |  Y   |  U     |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F     |  G    |                   |  H   |  J     |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V     |  B    | "CAPS" |  |  "]"  |  N   |  M     |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  |  GUI   | LOWER | SPACE  |  | ENTER | BSPC |  RAISE | CAPS  |

            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3     &kp N4    &kp N5                                &kp N6    &kp N7    &kp N8     &kp N9   &kp N0         &kp GRAVE
&kp TAB     &kp Q   &kp W   &kp F      &kp P     &kp B                                 &kp J     &kp L     &kp U      &kp Y    &kp SEMICOLON  &kp BACKSLASH
&kp ESCAPE  &kp A   &kp R   &kp S      &kp T     &kp G                                 &kp M     &kp N     &kp E      &kp I    &kp O          &kp ENTER
&kp LCTRL   &kp Z   &kp X   &kp C      &kp D     &kp V     &to 1        &kp C_PP       &kp K     &kp H     &kp COMMA  &kp DOT  &kp FSLH       &kp RSHFT
                            &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE    &kp BACKSPACE  &kp RGUI  &kp RGUI  &kp RGUI
            >;

            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DEC>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  TOG |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &out OUT_TOG                        &trans     &trans     &trans           &trans    &trans    &bt BT_CLR
&kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6                              &kp F7     &kp F8     &kp F9           &kp F10   &kp F11   &kp F12
&kp GRAVE        &kp EXCL         &kp AT           &kp HASH         &kp DOLLAR       &kp PRCNT                           &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &ext_power EP_ON  &to 0     &trans  &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                                                   &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans            &trans    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   | PG_UP |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  <-  |   v   |   ^   |  ->  |       | PG_DN |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  -   |   +   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans     &trans  &trans  &trans   &trans   &trans                     &trans     &trans       &trans     &trans     &trans    &trans
&kp GRAVE  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                     &kp N6     &kp N7       &kp N8     &kp N9     &kp N0    &kp PG_UP
&kp F1     &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &kp LEFT   &kp DOWN     &kp UP     &kp RIGHT  &trans    &kp PG_DN
&kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp MINUS  &kp KP_PLUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH
                           &trans   &trans   &trans   &trans    &trans  &trans     &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
